# Copy this to .env and fill in your values.
# Never commit .env to version control.

# ── RunPod credentials ─────────────────────────────────────────────────────
# Your RunPod API key (Settings → API Keys in the RunPod console)
RUNPOD_API_KEY=your_runpod_api_key_here

# Your RunPod secret key (shown alongside the API key in the RunPod console)
RUNPOD_SECRET_KEY=your_runpod_secret_key_here

# The Network Volume ID — shown in Storage → Network Volumes in RunPod console
RUNPOD_BUCKET=your_volume_id_here

# RunPod region for your volume
# Common values: eu-ro-1  |  us-tx-3  |  us-ca-1  |  ca-on-3
RUNPOD_REGION=eu-ro-1

# S3 endpoint — auto-derived from RUNPOD_REGION as https://s3api-{region}.runpod.io
# Leave blank unless you need to override.
RUNPOD_ENDPOINT_URL=
